{
  "manifest_version": 3,
  "name": "Gemini Automation Pro",
  "version": "1.0.0",
  "description": "Automate content generation on Gemini platforms",
  "action": {
    "default_title": "Toggle Gemini Automation Sidebar"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://business.gemini.google/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://business.gemini.google/*"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "storage.js",
        "logger.js"
      ],
      "matches": [
        "https://gemini.google.com/*",
        "https://business.gemini.google/*"
      ]
    }
  ]
}